{
  "name": "tachyon-drive",
  "version": "2.1.0",
  "description": "Extendable typescript/javascript storage driver implementation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/tachyon-drive",
  "keywords": [
    "storage",
    "driver"
  ],
  "author": "mharj",
  "license": "MIT",
  "peerDependencies": {
    "@luolapeikko/core-ts-type": ">= 0.0.7",
    "@luolapeikko/key-logger": ">= 0.1.0",
    "@luolapeikko/result-option": ">= 1.0.0",
    "@luolapeikko/logger-type": ">= 0.1.0"
  }
}
