{
  "name": "tachyon-expire-cache",
  "version": "2.0.0",
  "description": "tachyon drive enabled async cache with expire support",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.mts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/tachyon-drive",
  "keywords": [
    "storage",
    "cache",
    "driver",
    "nodejs"
  ],
  "author": "mharj",
  "license": "MIT",
  "devDependencies": {
    "tachyon-drive": "workspace:*",
    "tachyon-drive-node-fs": "workspace:*"
  },
  "peerDependencies": {
    "@luolapeikko/cache-types": ">= 0.0.8",
    "@luolapeikko/key-logger": ">= 0.1.0",
    "@luolapeikko/logger-type": ">= 0.1.0",
    "tachyon-drive": ">= 2.0.0"
  }
}
