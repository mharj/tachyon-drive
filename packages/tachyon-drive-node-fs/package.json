{
  "name": "tachyon-drive-node-fs",
  "version": "2.1.0",
  "description": "Nodejs fs module storage driver implementation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/tachyon-drive",
  "keywords": [
    "storage",
    "driver",
    "nodejs"
  ],
  "author": "mharj",
  "license": "MIT",
  "devDependencies": {
    "tachyon-drive": "workspace:*"
  },
  "peerDependencies": {
    "@luolapeikko/core-ts-type": ">= 0.0.7",
    "@luolapeikko/logger-type": ">= 0.1.0",
    "tachyon-drive": ">= 2.1.0"
  }
}
